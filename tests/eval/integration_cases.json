        "risk_level": "LOW",
        "needs_search": false
      },
      "expect_engineering_mode": true,
      "expect_verify_backend": "cpp",
      "expected_nodes": ["engineering_execution"],
      "expected_status": ["COMPLETED", "WAITING_REVIEW", "REASONED", "POLICY_CHECKED"]
    },
    {
      "id": "integration_engineering_makefile",
      "execution_mode": "single",
      "mock_engineering_bounded": true,
      "input": {
        "goal": "多文件 Makefile demo 小项目，make demo",
        "risk_level": "LOW"
      },
      "expect_engineering_mode": true,
      "expect_verify_backend": "make_cpp_demo",
      "expected_nodes": ["engineering_execution"],
      "expected_status": ["COMPLETED", "WAITING_REVIEW", "REASONED", "POLICY_CHECKED"]
    },
    {
      "id": "integration_session_manuscript_to_engineering",
      "execution_mode": "single",
      "mock_engineering_bounded": true,
      "input": {
        "goal": "做一个 2048 网页游戏，落盘到 games 目录",
        "risk_level": "LOW",
        "current_mode": "manuscript_mode",
        "mission": { "kind": "writing", "objective": "novel" },
        "writing_intent": { "enabled": true, "action": "write_body" }
      },
      "expect_engineering_mode": true,
      "expect_mode_switch_contains": "isolate",
      "expected_nodes": ["engineering_execution"],
      "expected_status": ["COMPLETED", "WAITING_REVIEW", "REASONED", "POLICY_CHECKED"]
    },
    {
      "id": "integration_qa_mode_blocks_writing",
      "execution_mode": "single",
      "mock_planning_qa_mode": true,
      "input": {
        "goal": "为什么 LangGraph 使用 checkpoint？",
        "risk_level": "LOW",
        "needs_search": false,
        "writing_intent": { "enabled": true, "action": "write_body" }
      },
      "expect_target_mode": "qa_mode",
      "expected_nodes": ["reasoning"],
      "forbidden_nodes": ["writing", "engineering_execution"],
      "expected_status": ["COMPLETED", "WAITING_REVIEW", "REASONED", "POLICY_CHECKED"]
    },
    {
      "id": "integration_supervisor_dual_worker",
      "execution_mode": "supervisor",
      "task_type": "supervisor",
      "mock_supervisor_workers": true,
      "input": {
        "goal": "analyze document and review code quality",
