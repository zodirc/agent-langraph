# 复制为 .env 后填写：cp .env.example .env

# ---------------------------------------------------------------------------
# 模型（有对应 API Key 则走真实 LLM，否则本地规则推理）
# ---------------------------------------------------------------------------
# 厂商：anthropic | openai | deepseek | glm | openai_compat
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-5
MODEL_ENABLED=true
# 可选：覆盖 config 默认 base_url（留空则用各厂商默认值）
# MODEL_BASE_URL=
# 可选：通用密钥（openai_compat 或 yaml api_key 回退）
# MODEL_API_KEY=

# --- Anthropic（MODEL_PROVIDER=anthropic）---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI（MODEL_PROVIDER=openai）---
# OPENAI_API_KEY=
# MODEL_NAME=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek（MODEL_PROVIDER=deepseek，OpenAI 兼容）---
# DEEPSEEK_API_KEY=
# MODEL_NAME=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 智谱 GLM（MODEL_PROVIDER=glm，OpenAI 兼容）---
# ZHIPUAI_API_KEY=
# MODEL_NAME=glm-4.7
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 宿主机访问端口（容器内固定 8000）
HOST_PORT=8001

# Docker 内置 PostgreSQL（与 docker-compose.yml 中 postgres 服务一致，一般无需改）
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
# 以下由 compose 自动注入 agent 容器，仅在不使用 compose 时需手动设置：
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://agent:agent@postgres:5432/agent
# CHECKPOINT_BACKEND=postgres

# 应用
APP_SECRET_KEY=change-me-in-production

# 认证（Docker 生产 compose 默认 AUTH_ENABLED=true；dev overlay 默认 false）
AUTH_ENABLED=true
ADMIN_PASSWORD=admin
SERVICE_API_KEY=

# 多租户（Docker 内需 CONFIG_PATH=config.docker.yaml，由 compose 注入）
# MULTI_TENANT_ENABLED=false
# TENANT_MAX_TASKS_PER_DAY=1000
# TENANT_MAX_TOKENS_PER_DAY=500000
# TENANT_MAX_CONCURRENT_TASKS=10
# 多副本时叠加 docker-compose.redis.yml：
# TENANT_QUOTA_BACKEND=redis
# TENANT_QUOTA_REDIS=true
# RATE_LIMIT_REDIS=true
# REDIS_URL=redis://redis:6379/0

# 可选：向量 Embedding
VOYAGE_API_KEY=

# 可选：MCP 外部工具（见 config.yaml mcp 段与 app/services/mcp_bridge.py）
# MCP_ENABLED=true

# 可选：Mission LLM 步进决策（默认规则；开启后 LLM 提议 StepDecision，失败回退规则）
# MISSION_LLM_DECIDE=false

# 可选：推理模式 direct | cot | react（也可在任务 payload 中设置 reasoning_mode）
# REASONING_MODE=direct

# 可选：每任务 token 预算（0=不限制）
# DEFAULT_TOKEN_BUDGET=0

# 可选：预算紧张时降级模型名
# MODEL_FALLBACK_NAME=

# 可选：Secrets 后端 env | k8s | vault
# SECRETS_BACKEND=env

# API 限流（Docker config.docker.yaml 默认 enabled=true）
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS=false

# 可选：A2A 自注册 URL（多实例发现）
# A2A_SELF_URL=http://127.0.0.1:8000

# 可选：PostgreSQL 只读副本（读路由）
# DATABASE_READ_URL=postgresql://agent:agent@postgres-replica:5432/agent

# 可选：任务队列轮询（调度器将 cron 任务入队后由 poller 按优先级执行）
# 见 config.yaml task_queue 段

# 可选：开启规则推理捷径（默认关闭；规划已无规则捷径）
# FAST_REASONING_ENABLED=false
