# 快速开始
#   cp .env.example .env
#   可同时填写多个厂商 Key；用 MODEL_PROVIDER 指定当前使用哪一个
#   make init && make up
# 切换厂商：改 MODEL_PROVIDER（及 MODEL_NAME）后 make restart
# 高级项见 docs/ENV_REFERENCE.md

MODEL_ENABLED=true

# 当前使用的厂商：anthropic | openai | deepseek | glm | openai_compat
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-4-5

# =============================================================================
# 各厂商凭据（可同时配置多组 Key，未选中的厂商 Key 仅保留备用）
# =============================================================================

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 智谱 GLM
ZHIPUAI_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 自定义 OpenAI 兼容网关（MODEL_PROVIDER=openai_compat 时使用）
MODEL_API_KEY=
# MODEL_BASE_URL=https://your-gateway.example/v1

# =============================================================================
# 切换示例（填好多个 Key 后改下面两行即可，无需删掉其他 Key）
# =============================================================================
# MODEL_PROVIDER=deepseek
# MODEL_NAME=deepseek-v4-flash

# =============================================================================
# 向量 Embedding（Docker 镜像默认 local_minilm，模型已内置，一般无需改）
# =============================================================================
# EMBEDDING_MODEL=local_minilm
# LOCAL_EMBEDDING_CACHE_DIR=/data/models/sentence-transformers
# 若改用外接 OpenAI 兼容服务：EMBEDDING_MODEL=openai_compat + EMBEDDING_BASE_URL=...

# =============================================================================
# 以下由 make init / scripts/setup.sh 自动补全，一般无需手改
# =============================================================================
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# HOST_PORT=8080
# HTTP_PORT=8081
# AUTH_ENABLED=false
# ADMIN_PASSWORD=admin
# PUBLIC_DOMAIN=localhost
# DEFAULT_SNI=
